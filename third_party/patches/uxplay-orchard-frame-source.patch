+#ifdef _WIN32
+#define ORCHARD_FRAME_DATA_OFFSET 64
+#define ORCHARD_FRAME_DATA_CAPACITY (16 * 1024 * 1024)
+#define ORCHARD_FRAME_MAGIC 0x4843524f
+
+typedef struct orchard_frame_header_s {
+    volatile LONG state;
+    guint32 magic;
+    guint32 version;
+    volatile LONG sequence;
+    guint32 width;
+    guint32 height;
+    guint32 stride;
+    guint32 payload_length;
+} orchard_frame_header_t;
+
+static HANDLE orchard_frame_mapping = NULL;
+static unsigned char *orchard_frame_view = NULL;
+
+static gboolean orchard_open_frame_mapping(void) {
+    if (orchard_frame_view) {
+        return TRUE;
+    }
+
+    const char *mapping_name = g_getenv("ORCHARD_FRAME_MAP");
+    if (!mapping_name || !mapping_name[0]) {
+        return FALSE;
+    }
+
+    orchard_frame_mapping = CreateFileMappingA(
+        INVALID_HANDLE_VALUE,
+        NULL,
+        PAGE_READWRITE,
+        0,
+        ORCHARD_FRAME_DATA_OFFSET + ORCHARD_FRAME_DATA_CAPACITY,
+        mapping_name);
+    if (!orchard_frame_mapping) {
+        logger_log(
+            logger,
+            LOGGER_ERR,
+            "Could not open Orchard frame mapping (error %lu)",
+            GetLastError());
+        return FALSE;
+    }
+
+    orchard_frame_view = (unsigned char *) MapViewOfFile(
+        orchard_frame_mapping,
+        FILE_MAP_ALL_ACCESS,
+        0,
+        0,
+        ORCHARD_FRAME_DATA_OFFSET + ORCHARD_FRAME_DATA_CAPACITY);
+    if (!orchard_frame_view) {
+        logger_log(
+            logger,
+            LOGGER_ERR,
+            "Could not map Orchard frame memory (error %lu)",
+            GetLastError());
+        CloseHandle(orchard_frame_mapping);
+        orchard_frame_mapping = NULL;
+        return FALSE;
+    }
+
+    orchard_frame_header_t *header =
+        (orchard_frame_header_t *) orchard_frame_view;
+    header->state = 0;
+    header->magic = ORCHARD_FRAME_MAGIC;
+    header->version = 1;
+    header->sequence = 0;
+    MemoryBarrier();
+    logger_log(logger, LOGGER_INFO, "Orchard shared-frame transport ready");
+    return TRUE;
+}
+
+static GstFlowReturn orchard_frame_new_sample(
+    GstAppSink *app_sink,
+    gpointer user_data) {
+    (void) user_data;
+
+    GstSample *sample = gst_app_sink_pull_sample(app_sink);
+    if (!sample) {
+        return GST_FLOW_ERROR;
+    }
+
+    if (!orchard_open_frame_mapping()) {
+        gst_sample_unref(sample);
+        return GST_FLOW_OK;
+    }
+
+    GstCaps *caps = gst_sample_get_caps(sample);
+    GstBuffer *buffer = gst_sample_get_buffer(sample);
+    GstVideoInfo video_info;
+    GstMapInfo map_info;
+    if (!caps ||
+        !buffer ||
+        !gst_video_info_from_caps(&video_info, caps) ||
+        !gst_buffer_map(buffer, &map_info, GST_MAP_READ)) {
+        gst_sample_unref(sample);
+        return GST_FLOW_OK;
+    }
+
+    guint32 width = GST_VIDEO_INFO_WIDTH(&video_info);
+    guint32 height = GST_VIDEO_INFO_HEIGHT(&video_info);
+    gint source_stride = GST_VIDEO_INFO_PLANE_STRIDE(&video_info, 0);
+    if (source_stride < 0) {
+        source_stride = -source_stride;
+    }
+
+    guint64 expected_length = (guint64) source_stride * height;
+    guint32 payload_length = (guint32) MIN(
+        MIN(expected_length, map_info.size),
+        ORCHARD_FRAME_DATA_CAPACITY);
+    if (width > 0 &&
+        height > 0 &&
+        source_stride >= (gint) width * 4 &&
+        expected_length <= ORCHARD_FRAME_DATA_CAPACITY &&
+        payload_length == expected_length) {
+        orchard_frame_header_t *header =
+            (orchard_frame_header_t *) orchard_frame_view;
+        InterlockedExchange(&header->state, 0);
+        header->width = width;
+        header->height = height;
+        header->stride = (guint32) source_stride;
+        header->payload_length = payload_length;
+        memcpy(
+            orchard_frame_view + ORCHARD_FRAME_DATA_OFFSET,
+            map_info.data,
+            payload_length);
+        MemoryBarrier();
+        InterlockedIncrement(&header->sequence);
+        InterlockedExchange(&header->state, 1);
+    }
+
+    gst_buffer_unmap(buffer, &map_info);
+    gst_sample_unref(sample);
+    return GST_FLOW_OK;
+}
+
+static GstBusSyncReply orchard_video_overlay_sync_handler(
+    GstBus *bus,
+    GstMessage *message,
+    gpointer user_data) {
+    (void) bus;
+    (void) user_data;
+
+    if (!gst_is_video_overlay_prepare_window_handle_message(message)) {
+        return GST_BUS_PASS;
+    }
+
+    const char *orchard_video_hwnd = g_getenv("ORCHARD_VIDEO_HWND");
+    if (!orchard_video_hwnd || !orchard_video_hwnd[0]) {
+        return GST_BUS_PASS;
+    }
+
+    guint64 parsed_hwnd = g_ascii_strtoull(orchard_video_hwnd, NULL, 10);
+    if (parsed_hwnd == 0 || !GST_IS_VIDEO_OVERLAY(GST_MESSAGE_SRC(message))) {
+        return GST_BUS_PASS;
+    }
+
+    gst_video_overlay_set_window_handle(
+        GST_VIDEO_OVERLAY(GST_MESSAGE_SRC(message)),
+        (guintptr) parsed_hwnd);
+    logger_log(
+        logger,
+        LOGGER_INFO,
+        "Prepared Direct3D video surface for Orchard HWND %s",
+        orchard_video_hwnd);
+    gst_message_unref(message);
+    return GST_BUS_DROP;
+}
