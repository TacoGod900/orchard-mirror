<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>orchard-mirror-probe</AssemblyName>
    <RootNamespace>Orchard.Mirror.Probe</RootNamespace>
  </PropertyGroup>
  <!--
    No PackageReference. BouncyCastle went with FreshIdentity when the keybag track was dropped,
    which puts Mirror back in line with the repository's dependency-free policy
    (toolchains/orchard-toolchain.lock.json records externalPackageCount 0).
  -->
</Project>
