<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="Orchard.Mirror" />

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11. Without these the OS reports a lied-about version and applies
           compatibility shims, including DPI virtualization. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}" />
    </application>
  </compatibility>

  <!--
    DPI awareness is deliberately NOT declared here. WinForms refuses to have it in both the
    manifest and the project (analyzer WFO0003), and it wants to own it: `ApplicationHighDpiMode`
    in the .csproj makes the generated ApplicationConfiguration.Initialize() call
    Application.SetHighDpiMode(PerMonitorV2) before the first window exists.

    It is set to PerMonitorV2 there, and that is load-bearing rather than hygiene. With no
    declaration at all the generator defaulted to SystemAware, so dragging the window to a display
    at a different scale made Windows bitmap-stretch the whole thing: a mirrored phone screen,
    blurred by the OS, with the text blurred a second time on top of that.
  -->
</assembly>
